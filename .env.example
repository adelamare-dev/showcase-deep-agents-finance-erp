# Agent endpoint used by the web runtime (this is the default).
REMOTE_ACTION_URL=http://127.0.0.1:8123/copilotkit/agents/finance_erp_agent

# Telemetry is already off by default (next.config.ts); set to "false" to opt in.
COPILOTKIT_TELEMETRY_DISABLED=true

# Where the browser reaches the agent service (this is the default). The agent
# allows this page's origin through FRONTEND_ORIGIN (default http://localhost:3000).
NEXT_PUBLIC_ERP_API_URL=http://localhost:8123
