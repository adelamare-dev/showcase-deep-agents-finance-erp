{
  "name": "deep-agents-finance-erp",
  "version": "0.3.0",
  "private": true,
  "description": "Deep Agents Finance ERP (Showcase) - Multi-agent orchestration",
  "author": {
    "name": "Antoine Delamare",
    "email": "antoine@blockchain-cie.com",
    "url": "https://www.linkedin.com/in/adelamare/"
  },
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,agent \"pnpm:dev:web\" \"pnpm:dev:agent\"",
    "dev:web": "next dev",
    "dev:agent": "cd agent && uv run uvicorn main:app --host 127.0.0.1 --port 8123 --reload",
    "demo": "pnpm build && concurrently --kill-others-on-fail --names web,agent \"pnpm:start\" \"pnpm:start:agent\"",
    "build": "next build",
    "start": "next start",
    "start:agent": "cd agent && uv run uvicorn main:app --host 127.0.0.1 --port 8123",
    "lint": "eslint .",
    "test:agent": "cd agent && uv run pytest -q",
    "e2e:build": "node e2e/build.mjs",
    "postinstall": "cd agent && uv sync"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.2",
    "@copilotkit/react-core": "1.80.0",
    "@copilotkit/runtime": "1.80.0",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "16.4.3",
    "radix-ui": "^1.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^2.15.3",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
